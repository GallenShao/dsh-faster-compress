{
  "name": "dsh-faster-compress",
  "version": "0.2.0",
  "description": "Prepare DeepSeek Harness context summaries in the background to reduce compaction pauses.",
  "author": "gallenshao <shaojialun@pku.edu.cn>",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "cordis",
    "compaction",
    "context-window",
    "llm",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client/index.js"
    },
    "./engine": {
      "default": "./src/engine.js"
    }
  },
  "files": [
    "src",
    "client",
    "locale",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "meta": {
    "title": {
      "zh": "更快压缩 · Faster Compress",
      "en": "Faster Compress"
    },
    "description": {
      "zh": "提前在后台准备上下文摘要，减少长对话里的压缩等待。",
      "en": "Prepare DeepSeek Harness context summaries in the background to reduce compaction pauses."
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check client/index.js && for f in src/*.js src/*.cjs scripts/*.mjs; do node --check \"$f\"; done",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-client.mjs && node scripts/build-artwork.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GallenShao/dsh-faster-compress.git"
  },
  "homepage": "https://github.com/GallenShao/dsh-faster-compress#readme",
  "bugs": {
    "url": "https://github.com/GallenShao/dsh-faster-compress/issues"
  }
}
