{
  "name": "dsh-faster-compress",
  "version": "0.1.0",
  "description": "Context compaction that never blocks the agent. Summaries are generated ahead of the pressure threshold and committed at the next step boundary, so a compaction costs no waiting time.",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "cordis",
    "compaction",
    "context-window",
    "llm"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "meta": {
    "title": "Faster Compress",
    "description": "Compacts context in the background so the agent never pauses to wait for a summary."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "check": "node --check src/index.js && for f in src/*.js; do node --check \"$f\"; done",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
